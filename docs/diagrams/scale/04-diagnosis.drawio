<mxfile host="opslab"><diagram name="4. 진단 순서 — 왜 안 늘어나나, 왜 안 비워지나"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="① 증상: 파드 수가 안 늘어남? 파드가 Pending? 노드 작업이 멈춤? DB 가 비었거나 안 뜸?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1140" height="50" as="geometry"/></mxCell><mxCell id="c2" value="파드 수가 안 늘어남&lt;br&gt;kubectl describe hpa&lt;br&gt;→ Conditions·Events&lt;br&gt;→ metrics-server·요청·대상" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="270" height="115" as="geometry"/></mxCell><mxCell id="c3" value="Pending&lt;br&gt;kubectl describe pod (이벤트)&lt;br&gt;→ kubectl get nodeclaim&lt;br&gt;→ Karpenter 로그&lt;br&gt;→ NodePool·EC2NodeClass" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="310" y="110" width="270" height="115" as="geometry"/></mxCell><mxCell id="c4" value="노드 작업이 멈춤&lt;br&gt;kubectl get nodes (cordon)&lt;br&gt;→ drain 메시지&lt;br&gt;→ emptyDir·DaemonSet·PDB" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="600" y="110" width="270" height="115" as="geometry"/></mxCell><mxCell id="c5" value="DB 이상&lt;br&gt;kubectl get pvc,volumesnapshot&lt;br&gt;→ describe pod(볼륨 AZ)&lt;br&gt;→ 스냅샷 복원" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="890" y="110" width="270" height="115" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c1" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c1" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c1" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="② 바꾼 것 찾기: kubectl get … -o yaml 과 기준 파일 비교 · EKS 감사 로그(누가 patch 했나)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="255" width="1140" height="45" as="geometry"/></mxCell><mxCell id="c11" value="③ 고치기: 기준값으로 되돌리기 → 1~2분 지켜보기(HPA 15초 주기·Karpenter 즉시·노드 Ready 1~3분)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="1140" height="45" as="geometry"/></mxCell><mxCell id="c12" value="④ 재발 방지: 요청은 실제 사용량에서 · HPA 최소&amp;lt;최대 · NodePool 한도·조건은 근거와 함께 · 드레인 옵션은 의미를 알고 · 스냅샷 주기" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="385" width="1140" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>