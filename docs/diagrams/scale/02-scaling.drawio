<mxfile host="opslab"><diagram name="2. 늘어나는 순서 — 파드 먼저, 노드는 그다음"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="① 트래픽 급증&lt;br&gt;CPU 사용률 ↑" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="200" height="70" as="geometry"/></mxCell><mxCell id="c2" value="② HPA&lt;br&gt;사용률 = 사용량 ÷ 요청(requests)&lt;br&gt;목표 50% 넘으면 파드 수 ↑" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="60" width="250" height="70" as="geometry"/></mxCell><mxCell id="c3" value="③ 스케줄러&lt;br&gt;새 파드를 놓을 자리 찾기" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="530" y="60" width="220" height="70" as="geometry"/></mxCell><mxCell id="c4" value="④ 자리 없음 → Pending&lt;br&gt;(Insufficient cpu)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="780" y="60" width="220" height="70" as="geometry"/></mxCell><mxCell id="c5" value="⑤-1 클러스터 오토스케일러&lt;br&gt;노드 그룹 원하는 수 +1&lt;br&gt;(최대 크기까지만) · 3~5분" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFF4E5;strokeColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="250" y="200" width="330" height="85" as="geometry"/></mxCell><mxCell id="c6" value="⑤-2 Karpenter&lt;br&gt;Pending 파드에 맞는 EC2 를 골라 바로 생성&lt;br&gt;NodePool 조건·한도 안에서 · 1~2분" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="200" width="380" height="85" as="geometry"/></mxCell><mxCell id="c7" value="⑥ 새 노드 Ready → 파드 Running" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#D5E8D4;