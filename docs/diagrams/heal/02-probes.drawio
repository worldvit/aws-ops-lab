<mxfile host="opslab"><diagram name="2. 건강검진(probe) 역할 — 느린 앱의 하루"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="시간 →" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="100" height="30" as="geometry"/></mxCell><mxCell id="c2" value="0~35초: 프로세스 기동 중&lt;br&gt;(포트 닫힘)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="300" height="70" as="geometry"/></mxCell><mxCell id="c3" value="35~50초: 캐시 데우기&lt;br&gt;/health 200 · /ready 503" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="340" y="60" width="300" height="70" as="geometry"/></mxCell><mxCell id="c4" value="50초~: 손님 받음&lt;br&gt;/health 200 · /ready 200" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="660" y="60" width="300" height="70" as="geometry"/></mxCell><mxCell id="c5" value="startup /health — &quot;아직 출근 준비 중&quot;&lt;br&gt;성공할 때까지 liveness·readiness 를 쉬게 함 (최대 90초)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="620" height="60" as="geometry"/></mxCell><mxCell id="c6" value="readiness /ready — &quot;손님 받을 준비?&quot; 아니면 트래픽에서 뺌(재시작 X)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#326CE5;fontColor=#ffffff;strokeColor=#1F4FB0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="240" width="620" height="55" as="geometry"/></mxCell><mxCell id="c7" value="liveness /health — &quot;살아 있나?&quot; 아니면 재시작&lt;br&gt;얕게: 프로세스만. DB 같은 바깥 의존성은 보지 않는다" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="660" y="315" width="480" height="65" as="geometry"/></mxCell><mxCell id="c8" value="✗ liveness 가 DB 까지 보면: DB 3분 장애 → 모든 파드 재시작 → 재시작 대기(백오프)로 더 길게 → 자동화가 장애를 키움" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="410" width="1120" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>